{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.mcp.json)",
      "Edit(**/.git/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.git-credentials)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(* | sh*)",
      "Bash(* | bash*)",
      "Bash(*|sh*)",
      "Bash(*|bash*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(gh auth token*)",
      "Bash(gh auth status --show-token*)",
      "Bash(gh secret *)",
      "Bash(gh gist *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh api -X DELETE *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git config --global *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo rm -rf *)",
      "Bash(npm publish*)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(iex *)",
      "PowerShell(* | iex*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Remove-Item * -Recurse -Force*)",
      "PowerShell(gh auth token*)"
    ],
    "ask": [
      "Edit(**/.claude/skills/**)",
      "Edit(**/evals/**)",
      "Edit(**/.github/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit.js\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
